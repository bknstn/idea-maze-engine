# Copy this example to deploy/idea-maze.env and keep the local copy out of
# source control. The HTTP service refuses to start until a non-empty bearer
# token and a future, timezone-qualified expiry are set.
IDEA_MAZE_MCP_BEARER_TOKEN=
IDEA_MAZE_MCP_BEARER_TOKEN_EXPIRES_AT=2030-01-01T00:00:00Z

# Replace localhost with the public hostname configured at the TLS proxy.
IDEA_MAZE_MCP_ALLOWED_HOSTS=["localhost"]
IDEA_MAZE_MCP_ALLOWED_ORIGINS=[]
IDEA_MAZE_MCP_TRUSTED_PROXY_PEERS=["127.0.0.1"]

# Optional provider credentials. Empty values disable that provider.
OPENAI_API_KEY=
TAVILY_API_KEY=

# Model routing remains provider-neutral and uses the service defaults unless
# explicitly overridden.
# IDEA_MAZE_LLM_PROVIDER=openai
# IDEA_MAZE_EXTRACTION_MODEL=gpt-5.6-luna
# IDEA_MAZE_RESEARCH_MODEL=gpt-5.6-terra
# IDEA_MAZE_EXPLORATION_MODEL=gpt-5.6-sol
