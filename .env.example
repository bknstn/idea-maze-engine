# Placeholders only. The CLI does not load .env automatically.
# Copy to .env, fill in values locally, then export them in your shell.

# Optional: empty means heuristic extraction and no model-generated research.
OPENAI_API_KEY=
IDEA_MAZE_LLM_PROVIDER=openai

# Shipped defaults. Override with models available to your API account.
IDEA_MAZE_EXTRACTION_MODEL=gpt-5.6-luna
IDEA_MAZE_RESEARCH_MODEL=gpt-5.6-terra
IDEA_MAZE_EXPLORATION_MODEL=gpt-5.6-sol

# Optional contextual web search.
TAVILY_API_KEY=

# Optional data root: data/ is created inside this directory.
# IDEA_MAZE_HOME=/absolute/path/to/your/local-state

# Optional TypeSafe/Jev shadow diagnostics, disabled by default.
# Select a model from your account's model inventory before enabling.
IDEA_MAZE_JEV_ENABLED=false
TYPESAFE_API_KEY=
IDEA_MAZE_JEV_MODEL=
